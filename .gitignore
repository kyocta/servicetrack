# ============================================================
# .gitignore — ServiceTrack (Workshop JKB)
# Mencegah file kredensial dan cache terunggah ke publik GitHub
# ============================================================

# 1. Environment & API Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# 2. Editor & IDE Secrets / MCP Server Configurations
.vscode/mcp.json
.vscode/settings.json
.cursor/mcp.json
.cursorrules
claude_desktop_config.json

# 3. Dependencies & Package Managers
node_modules/
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 4. OS System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 5. Local Dev & Build Caches
.vercel/
dist/
build/
.cache/
tmp/
*.tmp
*.log
